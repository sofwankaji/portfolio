{
  "schemaVersion": 1,
  "id": "reference-studio",
  "name": "Reference Studio",
  "description": "A clear introduction with selected work.",
  "category": "minimal",
  "pages": [
    "about",
    "work"
  ],
  "reference": {
    "url": "",
    "notes": ""
  },
  "design": {
    "enabled": false,
    "hideHeader": false,
    "hideFooter": false,
    "theme": {
      "id": "gallery",
      "name": "Blueprint",
      "background": "#edf3fb",
      "ink": "#17385c",
      "muted": "#526b85",
      "accent": "#2556bf",
      "surface": "#dde8f6",
      "line": "#b4c9e0",
      "footer": "#17385c",
      "footerInk": "#ffffff",
      "font": "Inter",
      "headingFont": "Inter",
      "headingTracking": -0.035,
      "headingWeight": "600",
      "cardRadius": 0,
      "imageRadius": 0,
      "cardStyle": "outline",
      "imageTreatment": "natural",
      "pattern": "grid",
      "buttonStyle": "solid",
      "buttonRadius": 0,
      "buttonHover": "wipe"
    },
    "sections": [
      {
        "id": "intro",
        "name": "Introduction",
        "height": 720,
        "background": "#edf3fb",
        "nodes": [
          {
            "id": "title",
            "type": "text",
            "x": 80,
            "y": 100,
            "width": 1040,
            "height": 240,
            "text": "Ideas made meaningful.",
            "motion": "rise",
            "fontSize": 80,
            "font": "Inter",
            "weight": "600",
            "tag": "h1",
            "lineHeight": 1.1,
            "color": "#17385c",
            "background": "#dde8f6"
          },
          {
            "id": "intro-copy",
            "type": "text",
            "x": 80,
            "y": 390,
            "width": 600,
            "height": 180,
            "text": "A thoughtful introduction.",
            "fontSize": 26,
            "font": "Inter",
            "color": "#17385c",
            "background": "#dde8f6"
          },
          {
            "id": "cta",
            "type": "button",
            "x": 80,
            "y": 600,
            "width": 320,
            "height": 64,
            "text": "Selected work",
            "href": "/portfolio/",
            "hover": "wipe",
            "hoverBackground": "#2556bf",
            "fontSize": 20,
            "font": "Inter",
            "align": "center",
            "color": "#ffffff",
            "background": "#2556bf"
          }
        ]
      },
      {
        "id": "work",
        "name": "Selected work",
        "height": 1400,
        "background": "#f3f4f6",
        "nodes": [
          {
            "id": "work-title",
            "type": "text",
            "x": 80,
            "y": 80,
            "width": 1040,
            "height": 100,
            "text": "Selected work.",
            "fontSize": 48,
            "font": "Inter",
            "weight": "600",
            "tag": "h2",
            "lineHeight": 1.1,
            "color": "#17385c",
            "background": "#dde8f6"
          },
          {
            "id": "work-grid",
            "type": "projects",
            "x": 80,
            "y": 240,
            "width": 1040,
            "height": 1100,
            "font": "Inter",
            "color": "#17385c",
            "background": "#dde8f6"
          }
        ]
      }
    ]
  },
  "bindings": [
    {
      "nodeId": "title",
      "path": "website.heroTitle",
      "target": "content"
    },
    {
      "nodeId": "intro-copy",
      "path": "profile.intro",
      "target": "content"
    },
    {
      "nodeId": "work-title",
      "path": "website.workTitle",
      "target": "content"
    }
  ]
}
