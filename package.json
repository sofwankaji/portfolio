  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:web": "tsx server/index.ts --web-only",
    "dev:studio": "tsx server/index.ts --studio-only",
    "build": "tsx scripts/build.ts",
    "build:public": "tsx scripts/export-public.ts",
    "test": "tsx --test tests/*.test.ts",
    "template:check": "tsx scripts/template-tool.ts check",
    "template:import": "tsx scripts/template-tool.ts import",
    "template:schema": "tsx scripts/template-tool.ts schema",
    "template:example": "tsx scripts/template-tool.ts example",
    "template:agent": "tsx scripts/template-tool.ts agent"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-code-block-lowlight": "3.32.1",
    "@tiptap/extension-highlight": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extension-placeholder": "3.32.1",
    "@tiptap/extension-subscript": "3.32.1",
    "@tiptap/extension-superscript": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extension-text-align": "3.32.1",
    "@tiptap/extension-text-style": "3.32.1",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "busboy": "^1.6.0",
    "entities": "9.0.0",
    "esbuild": "^0.25.0",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0"
